# ============================================================
# AI Smart Campus System — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-very-secret-key-change-this-in-production

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_campus_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# --- Email (SMTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=Smart Campus System <your_email@gmail.com>

# --- Face Recognition ---
FACE_RECOGNITION_THRESHOLD=0.60
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
LIVENESS_BLINK_THRESHOLD=3
UNKNOWN_SAVE_PATH=app/static/images/security

# --- Attendance Rules ---
LATE_THRESHOLD_MINUTES=10
MIN_ATTENDANCE_PERCENT=75

# --- ML Model ---
RISK_MODEL_PATH=ai_models/risk_model.pkl
RISK_RETRAIN_INTERVAL_DAYS=7

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRY_HOURS=24

# --- Upload ---
MAX_PHOTO_SIZE_MB=5
UPLOAD_FOLDER=app/static/images/uploads
